{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "executor-dashboard",
  "account_id": "__EXECUTOR_ACCOUNT_ID__",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "__EXECUTOR_DASHBOARD_HOSTNAME__",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "executor-dashboard",
      "database_id": "__EXECUTOR_D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceRelay"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "ACCESS_AUD": "__EXECUTOR_ACCESS_AUD__",
    "ACCESS_TEAM_DOMAIN": "__EXECUTOR_ACCESS_TEAM_DOMAIN__"
  }
}
