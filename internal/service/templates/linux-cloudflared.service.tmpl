[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ .CloudflaredBinaryPath }} tunnel --logfile {{ .CloudflaredLogPath }} run --token-file {{ .CloudflaredTokenPath }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
