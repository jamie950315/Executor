$ErrorActionPreference = "Stop"

$Binary = "{{ .BinaryPath }}"
$Config = "{{ .ConfigPath }}"
$TaskName = "ExecutorDesktop"
$DesktopUser = "{{ .DesktopUser }}"
$Action = New-ScheduledTaskAction -Execute $Binary -Argument "desktop --config `"$Config`""
$Trigger = New-ScheduledTaskTrigger -AtLogOn -User $DesktopUser
$Principal = New-ScheduledTaskPrincipal -UserId $DesktopUser -LogonType Interactive -RunLevel Limited
$Settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -ExecutionTimeLimit ([TimeSpan]::Zero)

Register-ScheduledTask -TaskName $TaskName -Action $Action -Trigger $Trigger -Principal $Principal -Settings $Settings -Description "Executor desktop helper" -Force | Out-Null

try {
  Start-ScheduledTask -TaskName $TaskName -ErrorAction Stop
} catch {
}
