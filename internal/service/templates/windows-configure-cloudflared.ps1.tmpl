$ErrorActionPreference = "Stop"

$Binary = "{{ .CloudflaredBinaryPath }}"
$TokenFile = "{{ .CloudflaredTokenPath }}"
$LogFile = "{{ .CloudflaredLogPath }}"
$ServiceName = "ExecutorCloudflared"

$ImagePath = "`"$Binary`" tunnel --logfile `"$LogFile`" run --token-file `"$TokenFile`""
if (Get-Service -Name $ServiceName -ErrorAction SilentlyContinue) {
  Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Services\$ServiceName" -Name ImagePath -Value $ImagePath
} else {
  New-Service -Name "ExecutorCloudflared" -BinaryPathName $ImagePath -DisplayName "Executor Cloudflare Tunnel" -StartupType Automatic
}
Restart-Service $ServiceName
